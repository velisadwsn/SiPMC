<main class="main">
  <div class="page-header">
    <div class="page-title">Data PC</div>

    <div class="page-actions">
      <a href="/pc/tambah" class="btn btn-add">+ Tambah Data</a>
    </div>

    <form method="GET" action="/pc" class="filter-area">
      <select name="bulan" onchange="this.form.submit()">
        <option value="Januari" <%= bulanAktif === 'Januari' ? 'selected' : '' %>>Januari</option>
        <option value="Februari" <%= bulanAktif === 'Februari' ? 'selected' : '' %>>Februari</option>
        <option value="Maret" <%= bulanAktif === 'Maret' ? 'selected' : '' %>>Maret</option>
        <option value="April" <%= bulanAktif === 'April' ? 'selected' : '' %>>April</option>
        <option value="Mei" <%= bulanAktif === 'Mei' ? 'selected' : '' %>>Mei</option>
        <option value="Juni" <%= bulanAktif === 'Juni' ? 'selected' : '' %>>Juni</option>
        <option value="Juli" <%= bulanAktif === 'Juli' ? 'selected' : '' %>>Juli</option>
        <option value="Agustus" <%= bulanAktif === 'Agustus' ? 'selected' : '' %>>Agustus</option>
        <option value="September" <%= bulanAktif === 'September' ? 'selected' : '' %>>September</option>
        <option value="Oktober" <%= bulanAktif === 'Oktober' ? 'selected' : '' %>>Oktober</option>
        <option value="November" <%= bulanAktif === 'November' ? 'selected' : '' %>>November</option>
        <option value="Desember" <%= bulanAktif === 'Desember' ? 'selected' : '' %>>Desember</option>
      </select>

     <div class="search-box">
    <input type="text" name="keyword" placeholder="Cari" value="<%= keyword %>">
    <button type="submit" style="display: none;"></button> </div>
    </form>
  </div>

  <!-- LIST PC -->
  <div class="pc-list">
    <% pcs.forEach(pc => { %>
      <div class="pc-card">
        <div class="pc-code"><%= pc.no %></div>

        <div class="pc-info">
          <strong><%= pc.model %></strong>
          <span><%= pc.serial_number %></span>
        </div>

        <a href="/pc/detail/<%= pc.device_id %>" class="btn-detail">Detail</a>
      </div>
    <% }) %>

    <% if (pcs.length === 0) { %>
      <p>Tidak ada PC untuk bulan <strong><%= bulanAktif %></strong></p>
    <% } %>
  </div>
</main>
