<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Login | SIPMC</title>
  <link rel="stylesheet" href="/style/pages/login.css">
</head>
<body>

  <!-- LOGO -->
  <img src="/images/kirana.png" class="logo left" alt="PT. Kirana Sakti Komputindo">
  <img src="/images/sig.png" class="logo right" alt="SIG">

  <!-- LOGIN BOX -->
  <div class="login-wrapper">
    <h1>LOGIN</h1>

    <form action="/" method="post" class="login-card">
      <div class="form-group">
        <label>Username</label>
        <input type="text" name="username" required>
      </div>

      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" required>
      </div>

      <button type="submit" class="btn-login">Masuk</button>
    </form>
  </div>

</body>
</html>
