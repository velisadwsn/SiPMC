<main class="main">
    <div class="page-header">
        <div class="page-title">
            Dashboard PMC - <%= currentMonth %> <%= currentYear %>
        </div>
    </div>

    <div class="dashboard-grid">
      
      <div class="stat-card dark-blue">
        <div class="card-top">
            <h3 class="card-label">TOTAL JADWAL <%= currentMonth.toUpperCase() %></h3>
            <span class="card-number"><%= stats.total %></span>
        </div>
        <div class="card-bottom">
            <div class="detail-item"><%= stats.totalLaptop %> Laptop</div>
            <div class="detail-item"><%= stats.totalPC %> PC</div>
        </div>
      </div>

      <div class="stat-card grey">
        <div class="card-top">
            <h3 class="card-label">PENDING / PROSES</h3>
            <span class="card-number"><%= stats.pending %></span>
        </div>
        <div class="card-bottom">
            <div class="detail-item"><%= stats.pendingLaptop %> Laptop</div>
            <div class="detail-item"><%= stats.pendingPC %> PC</div>
        </div>
      </div>

      <div class="stat-card soft-green">
        <div class="card-top">
            <h3 class="card-label">SELESAI (DONE)</h3>
            <span class="card-number" style="color: white;"><%= stats.done %></span>
        </div>
        <div class="card-bottom">
            <div class="detail-item"><%= stats.doneLaptop %> Laptop</div>
            <div class="detail-item"><%= stats.donePC %> PC</div>
        </div>
      </div>

    </div>
</main>