<main class="main">
    <div class="page-header">
        <div class="page-title">Edit Data Harian</div>
    </div>

    <div class="card">
        <form action="/harian/detail/update/<%= device.device_id %>" method="POST">
            
            <div class="form-grid-2col">
                <div class="col">
                    <div class="form-row">
                        <label>Model</label>
                        <input type="text" name="model" value="<%= device.model %>" required>
                    </div>

                    <div class="form-row">
                        <label>Serial Number</label>
                        <input type="text" name="serial_number" value="<%= device.serial_number %>" required>
                    </div>

                    <div class="form-row">
                        <label>CoCd</label>
                        <input type="text" name="cocd" value="<%= device.cocd %>">
                    </div>

                    <div class="form-row">
                        <label>Lokasi</label>
                        <input type="text" name="lokasi" value="<%= device.lokasi %>">
                    </div>
                </div>

                <div class="col">
                    <div class="form-row">
                        <label>Employee No</label>
                        <input type="text" name="employee_no" value="<%= device.employee_no %>">
                    </div>

                    <div class="form-row">
                        <label>Checked Out</label>
                        <input type="text" name="checked_out" value="<%= device.checked_out %>">
                    </div>

                    <div class="form-row">
                        <label>Hostname</label> 
                        <input type="text" name="hostname" value="<%= device.hostname %>" required>
                    </div>

                    <div class="form-row">
                        <label>No</label> 
                        <input type="text" name="no" value="<%= device.no %>" required>
                    </div>
                </div>
            </div>

            <h3 style="margin-top: 30px; margin-bottom: 15px; color: #0c2b57; border-bottom: 1px solid #eee; padding-bottom: 10px;">
                Preventive Maintenance Check (Harian)
            </h3>
            
            <div class="form-grid"> 
                <div class="form-row">
                    <label>Tipe Perangkat</label>
                    <select name="device_type" required>
                        <option value="Laptop" <%= device.device_type === 'Laptop' ? 'selected' : '' %>>Laptop</option>
                        <option value="PC" <%= device.device_type === 'PC' ? 'selected' : '' %>>PC</option>
                    </select>
                </div>

                <div class="form-row">
                    <label>Jadwal PMC</label>
                    <select name="jadwal_PMC">
                        <option value="Harian" selected>Harian</option>
                    </select>
                </div>

                <div class="form-row">
                    <label>Status PMC</label>
                    <select name="status_pmc">
                        <option value="Pending" <%= device.status_pmc === 'Pending' ? 'selected' : '' %>>Pending</option>
                        <option value="Done" <%= device.status_pmc === 'Done' ? 'selected' : '' %>>Done</option>
                    </select>
                </div>
            </div>

            <div class="actions">
                <a href="/harian/detail/<%= device.device_id %>" class="btn">Batal</a>
                <button type="submit" class="btn primary">Simpan Perubahan</button>
            </div>

        </form>
    </div>
</main>