<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Checklist PMC - <%= data.serial_number %></title>
    <style>
        body { font-family: 'Arial', sans-serif; background: #525659; padding: 20px; margin: 0; }
        .paper { background: white; width: 210mm; min-height: 297mm; padding: 12mm; margin: auto; box-shadow: 0 0 10px rgba(0,0,0,0.5); font-size: 10px; color: #000; }
        
        /* 1. HEADER */
        .header-container { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2px; }
        .logo-sisi { height: 42px; } .logo-sig { height: 38px; }
        .header-text { text-align: center; flex-grow: 1; }
        .header-text h3 { margin: 0; font-size: 14px; font-weight: bold; }
        .header-text p { margin: 2px 0 0; font-size: 12px; }
        .title-box { border: 1.5px solid black; text-align: center; padding: 4px; margin-bottom: 12px; font-size: 11px; letter-spacing: 1px; }

        /* 2. CONFIG BOX */
        .config-outer { border: 1.5px solid black; padding: 15px 12px; margin-bottom: 15px; }
        .data-grid { width: 100%; border-collapse: collapse; table-layout: fixed; }
        .data-grid td { padding: 0; text-align: center; vertical-align: bottom; }
        .val-cell { border-bottom: 1.2px solid black !important; height: 32px; font-size: 12px; padding-bottom: 2px !important; }
        .lab-cell { font-size: 10px; font-style: italic; padding-top: 4px !important; padding-bottom: 12px !important; }

        /* 3. MAIN TABLE */
        .main-table { width: 100%; border-collapse: collapse; margin-bottom: 12px; font-size: 10.5px; border-left: 1.2px solid black; }
        .main-table th, .main-table td { border-top: 1.2px solid black; border-bottom: 1.2px solid black; padding: 4px 8px; }
        
        /* Border V-Line standar */
        .v-line { border-right: 1.2px solid black; }
        
        /* Modifikasi Border Sesuai Instruksi Warna */
        .no-border-r { border-right: none !important; }
        .no-border-l { border-left: none !important; }
        .blue-last-line { border-right: 1.2px solid black !important; } /* Garis biru: pembatas terakhir */
        
        .bg-gray { background-color: #d9d9d9; font-weight: bold; text-align: center; }
        .center { text-align: center; }
        .italic { font-style: italic; }

        /* 4. FOOTER & SIGNATURE */
        .notes-area { border: 1.2px solid black; padding: 10px; min-height: 120px; font-size: 10px; line-height: 1.5; margin-bottom: 15px; }
        .sig-line { width: 85%; border-bottom: 1.2px solid black; margin: 55px auto 4px; min-height: 1px; }
        .ttd-img { max-height: 60px; display: block; margin: 0 auto -50px; position: relative; z-index: 1; }
        .footer-table { width: 100%; border-collapse: collapse; }
        .footer-table td { width: 33.33%; text-align: center; vertical-align: top; font-size: 10.5px; }

        .print-btn { position: fixed; top: 20px; right: 20px; padding: 12px 20px; background: #0c2b57; color: white; border: none; cursor: pointer; font-weight: bold; z-index: 1000; border-radius: 4px; }
        @media print { .print-btn { display: none; } body { background: white; padding: 0; } .paper { box-shadow: none; margin: 0; width: 100%; border: none; } }
        [contenteditable="true"]:hover { background: #fffde7; outline: 1px dashed #ccc; }
    </style>
</head>
<body>

<% 
    // Sinkronisasi tanggal
    const currentDate = new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
%>

<button class="print-btn" onclick="window.print()">UNDUH PDF (CTRL+P)</button>

<div class="paper">
    <div class="header-container">
        <img src="/images/sisi.png" class="logo-sisi">
        <div class="header-text">
            <h3>PT. Sinergi Informatika Semen Indonesia</h3>
            <p>Digital Service - Ops & Dev Infra</p>
        </div>
        <img src="/images/sig.png" class="logo-sig">
    </div>

    <div class="title-box">CHECKLIST PREVENTIVE MAINTENANCE</div>

    <div class="config-outer">
        <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
            <tr>
                <td width="35%"><span style="background-color: #e0e0e0; padding: 3px 10px; font-weight: bold;">Configurations Items</span></td>
                <td style="border: 1px solid black; width: 120px; text-align: center; color: #b8860b;">Date</td>
                <td style="border: 1px solid black; width: 220px; padding: 4px 12px;" contenteditable="true"><%= currentDate %></td>
                <td></td>
            </tr>
        </table>
        <table class="data-grid">
            <tr>
                <td class="val-cell">Laptop</td><td style="width: 40px;"></td>
                <td class="val-cell" contenteditable="true"><%= data.serial_number %></td><td style="width: 40px;"></td>
                <td class="val-cell">Padang</td>
            </tr>
            <tr><td class="lab-cell">Device</td><td></td><td class="lab-cell">ID Tagging Asset</td><td></td><td class="lab-cell">OpCo</td></tr>
            <tr>
                <td class="val-cell"><%= data.model %></td><td></td>
                <td class="val-cell"><%= data.serial_number %></td><td></td>
                <td class="val-cell" contenteditable="true">nama unit</td>
            </tr>
            <tr><td class="lab-cell">Merk/ Type</td><td></td><td class="lab-cell">Serial Number</td><td></td><td class="lab-cell">Location</td></tr>
        </table>
    </div>

    <table class="main-table">
        <tr class="bg-gray">
            <th rowspan="2" class="v-line" width="5%">Item</th> <th rowspan="2" class="v-line" width="30%">Description</th> <th colspan="2" class="v-line" width="20%">Condition</th>
            <th rowspan="2" class="no-border-r" width="45%">Information</th> </tr>
        <tr class="bg-gray" style="font-size: 8px;">
            <th class="v-line">Normal</th>
            <th class="v-line">Error</th>
        </tr>
        
        <tr>
            <td class="center v-line">1.</td>
            <td colspan="4" class="no-border-r"><b>Check Device Functions</b></td>
        </tr>

        <% 
            const items = [
                {n: 'Monitor / LCD', d: 'Dell', s: 'N'}, {n: 'RAM', d: '16 GB', s: 'N'}, {n: 'Hardisk', d: 'SSD 512 GB', s: 'N'},
                {n: 'Power Supply/ Adaptor/ Battery', d: '', s: 'N'}, {n: 'DVD/ CD ROM', d: '', s: 'E'},
                {n: 'Keyboard', d: 'Dell', s: 'N'}, {n: 'Mouse', d: 'Dell', s: 'N'}, {n: 'Clean of the device', d: '', s: 'N'}
            ];
            items.forEach((item) => { 
        %>
        <tr>
            <td class="no-border-r"></td> 
            <td class="v-line no-border-l italic"><%= item.n %></td>
            
            <td class="center v-line" contenteditable="true"><%= item.s === 'N' ? '✓' : '' %></td>
            
            <td class="center blue-last-line" contenteditable="true"><%= item.s === 'E' ? '✓' : '' %></td>
            
            <td class="no-border-r" contenteditable="true"><%= item.d %></td>
        </tr>
        <% }) %>

        <tr><td class="center v-line">2.</td><td colspan="4" class="no-border-r"><b>Standard Software</b></td></tr>
        <tr><td class="no-border-r"></td><td class="v-line no-border-l italic">Operating system</td><td colspan="2" class="v-line"></td><td class="no-border-r">Windows 11</td></tr>
        <tr><td class="center v-line">3.</td><td colspan="4" class="no-border-r"><b>Additional Software</b></td></tr>
        <tr><td class="no-border-r"></td><td class="v-line no-border-l italic">1. </td><td colspan="2" class="v-line"></td><td class="no-border-r">6. </td></tr>
    </table>

    <div style="font-weight: bold; margin-bottom: 2px;">Notes</div>
    <div class="notes-area" contenteditable="true">
        Hostname : <%= data.hostname %><br>IP Address : 192.168.16.62<br>MAC Address : 10:98:19:1E:CB:C1
    </div>

    <div style="text-align: right; margin-right: 40px; margin-bottom: 5px;">Padang, <span contenteditable="true"><%= currentDate %></span></div>
    <table class="footer-table">
        <tr><td>Person In Charge, SIG</td><td>PIC</td><td>Officer Preventive Maintenance</td></tr>
        <tr>
            <td style="padding-top: 50px;"><div class="sig-line"></div><%= data.checked_out || 'nama' %></td>
            <td style="padding-top: 50px;"><div class="sig-line"></div>nama employee</td>
            <td>
                <div style="height: 50px;"><% if (data.ttd) { %><img src="/images/ttd/<%= data.ttd %>" class="ttd-img"><% } %></div>
                <div class="sig-line"></div><%= data.pemeriksa || data.fullname %>
            </td>
        </tr>
    </table>
</div>

</body>
</html>