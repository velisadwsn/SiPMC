<main class="main">
  <div class="page-header">
    <div class="page-title">Laporan PMC Sewa (PC)</div>

<div class="tab-group">
      <a href="/laporan/pc" class="tab-btn active">Daftar PC</a>
      <a href="/laporan/laptop" class="tab-btn">Daftar Laptop</a>
    </div>

    <div class="filter-area">
      <form action="/laporan/pc" method="GET" style="display: flex; gap: 10px; align-items: center;">
        
        <select name="bulan" onchange="this.form.submit()" style="width: 150px;">
          <% 
            const daftarBulan = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
            daftarBulan.forEach(b => { 
          %>
            <option value="<%= b %>" <%= bulanAktif === b ? 'selected' : '' %>><%= b %></option>
          <% }) %>
        </select>

        <select name="tahun" onchange="this.form.submit()" style="width: 100px;">
          <% 
            const tahunSekarang = new Date().getFullYear();
            for(let i = tahunSekarang; i >= tahunSekarang - 3; i--) { 
          %>
            <option value="<%= i %>" <%= tahunAktif == i ? 'selected' : '' %>><%= i %></option>
          <% } %>
        </select>

        <div class="search-box">
          <input type="text" name="keyword" placeholder="Cari" value="<%= keyword %>">
        </div>
      </form>
    </div>
  </div>

  <table class="laporan-table">
    <thead>
      <tr>
        <th>No</th>
        <th>Model PC</th>
        <th>Serial Number</th>
        <th>Bulan</th>
        <th>Tahun</th>
        <th>Pemeriksa</th>
        <th>Foto Bukti</th> 
        <th>Aksi</th>
    
      </tr>
    </thead>
    <tbody>
      <% if (laporan.length > 0) { %>
        <% laporan.forEach(item => { %>
          <tr>
            <td><%= item.no %></td>
            <td><%= item.model %></td>
            <td><%= item.serial_number %></td>
            <td><%= item.bulan %></td>
            <td><%= item.tahun %></td>
            <td><%= item.pemeriksa || 'Tidak Ada Nama' %></td>
             <td>
              <% if (item.foto_bukti) { %>
                <span style="color: green;">Ada</span>
              <% } else { %>
                <span style="color: orange;">Belum Ada</span>
              <% } %>
            </td>
            <td>
              <div style="display: flex; gap: 10px;">
                <a href="/laporan/preview/<%= item.riwayat_id %>" target="_blank" class="btn primary" style="text-decoration: none; font-size: 13px;">PDF</a>
                <button onclick="openUploadModal('<%= item.riwayat_id %>')" class="btn" style="background: #28a745; color: white; border: none; font-size: 13px; padding: 5px 10px; border-radius: 4px; cursor: pointer;">Upload Bukti</button>
              </div>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="7" style="text-align: center; padding: 30px; color: #888;">
            Data tidak ditemukan untuk periode <%= bulanAktif %> <%= tahunAktif %>.
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>

  <div id="uploadModal" class="modal" style="display:none;">
  <div class="modal-content">
    <div class="modal-header">
      <h3>Upload Foto Bukti</h3>
      <span class="close" onclick="closeModal()">&times;</span>
    </div>
    <form id="uploadForm" action="" method="POST" enctype="multipart/form-data">
      <div class="modal-body">
        <input type="file" name="foto" accept="image/*" required>
      </div>
      <div class="modal-footer">
        <button type="submit" class="btn primary">Simpan</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openUploadModal(riwayatId) {
    const modal = document.getElementById('uploadModal');
    const form = document.getElementById('uploadForm');
    // Set action secara dinamis
    form.action = `/laporan/upload-bukti/${riwayatId}`;
    modal.style.display = 'block';
  }

  function closeModal() {
    document.getElementById('uploadModal').style.display = 'none';
  }
</script>

</main>