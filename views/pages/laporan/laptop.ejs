<main class="main">
  <div class="page-header">
    <div class="page-title">Laporan PMC Laptop</div>

    <div class="filter-area">
      <form action="/laporan/laptop" method="GET" style="display: flex; gap: 10px; align-items: center;">
        
        <select name="bulan" onchange="this.form.submit()" style="width: 150px;">
          <% 
            const daftarBulan = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
            daftarBulan.forEach(b => { 
          %>
            <option value="<%= b %>" <%= bulanAktif === b ? 'selected' : '' %>><%= b %></option>
          <% }) %>
        </select>

        <select name="tahun" onchange="this.form.submit()" style="width: 100px;">
          <% 
            const tahunSekarang = new Date().getFullYear();
            // Menampilkan tahun saat ini dan 3 tahun ke belakang
            for(let i = tahunSekarang; i >= tahunSekarang - 3; i--) { 
          %>
            <option value="<%= i %>" <%= tahunAktif == i ? 'selected' : '' %>><%= i %></option>
          <% } %>
        </select>

        <div class="search-box">
          <input type="text" name="keyword" placeholder="Cari Model / SN..." value="<%= keyword %>">
        </div>
      </form>
    </div>
  </div>

  <table class="laporan-table">
    <thead>
      <tr>
        <th>No</th>
        <th>Model</th>
        <th>Serial Number</th>
        <th>Bulan</th>
        <th>Tahun</th>
        <th>Pemeriksa</th>
        <th>Aksi</th>
      </tr>
    </thead>
    <tbody>
      <% if (laporan.length > 0) { %>
        <% laporan.forEach(item => { %>
          <tr>
            <td><%= item.no %></td>
            <td><%= item.model %></td>
            <td><%= item.serial_number %></td>
            <td><%= item.bulan %></td>
            <td><%= item.tahun %></td>
            <td style="font-weight: bold; color: #0c2b57;"><%= item.pemeriksa %></td>
            <td>
              <a href="/laporan/previewlaptop/<%= item.device_id %>" target="_blank" class="btn primary" style="text-decoration: none; font-size: 12px;">Cetak PDF</a>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="7" style="text-align: center; padding: 30px; color: #888;">
            Data tidak ditemukan untuk periode <%= bulanAktif %> <%= tahunAktif %>.
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</main>