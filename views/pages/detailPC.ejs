<main class="main">
  <div class="page-header">
    <div class="page-title">Detail Perangkat</div>
  </div>

  <div class="card">
    <div class="grid">
      <div><b>Model:</b><span><%= pmc.model %></span></div>
      <div><b>Employee No:</b><span><%= pmc.employee_no %></span></div>

      <div><b>Serial Number:</b><span><%= pmc.serial %></span></div>
      <div><b>Checked Out:</b><span><%= pmc.checked_out %></span></div>

      <div><b>Site:</b><span><%= pmc.site %></span></div>
      <div><b>Hostname SP:</b><span><%= pmc.hostname %></span></div>

      <div><b>Lokasi:</b><span><%= pmc.lokasi %></span></div>
    </div>
  </div>

  <div class="card">
    <h3>Preventive Maintenance Check (PMC)</h3>

    <div class="pmc-row">
      <span>Jadwal PMC:</span>
      <span><%= pmc.jadwal_pmc %></span>
    </div>

    <div class="pmc-row">
  <span>Status PMC:</span>
  <span class="badge <%= pmc.status_pmc.toLowerCase() %>">
    <%= pmc.status_pmc %> 
    <%= pmc.status_pmc === 'Done' ? '✓' : '' %>
  </span>
 
</div>
  </div>

  <div class="actions">
    <a href="/pc" class="btn">Kembali</a>

    <button class="btn danger" onclick="openHapusModal()">Hapus</button>

    <div id="hapusModal" class="modal">
      <div class="modal-content">
        <h3>Hapus Data?</h3>
        <p>Data dengan ID <%= pmc.id %> akan dihapus permanen.</p>
        <div class="modal-actions">
          <button onclick="closeHapusModal()" class="btn-red">Batal</button>
          <form action="/pc/detail/delete/<%= pmc.id %>" method="POST" style="display:inline;">
            <button type="submit" class="btn-green">Lanjutkan Hapus</button>
          </form>
        </div>
      </div>
    </div>

    <a href="/pc/detail/edit/<%= pmc.id %>" class="btn primary">
      Edit Perangkat & PMC
    </a>
  </div>
</main>

<script>
  function openHapusModal() {
    document.getElementById('hapusModal').style.display = 'flex';
  }

  function closeHapusModal() {
    document.getElementById('hapusModal').style.display = 'none';
  }

  // Menutup modal jika user klik di luar kotak putih
  window.onclick = function(event) {
    const modal = document.getElementById('hapusModal');
    if (event.target == modal) {
      closeHapusModal();
    }
  }
</script>