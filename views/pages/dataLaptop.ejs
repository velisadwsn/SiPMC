<main class="main">
    <div class="page-header">
        <div class="page-title">Data Laptop - <%= bulan || "Semua Bulan" %></div>
    </div>

    <div class="top-bar">
        <a href="/laptop/tambah" class="btn-tambah">+ Tambah Data</a>

        <div style="display: flex; align-items: center; gap: 15px;">
            <form action="/laptop" method="GET" class="search-form">
                <select name="bulan" class="input-select" onchange="this.form.submit()">
                    <option value="">- Semua Bulan -</option>
                    <option value="Januari" <%= bulan === 'Januari' ? 'selected' : '' %>>Januari</option>
                    <option value="Februari" <%= bulan === 'Februari' ? 'selected' : '' %>>Februari</option>
                    <option value="Maret" <%= bulan === 'Maret' ? 'selected' : '' %>>Maret</option>
                    <option value="April" <%= bulan === 'April' ? 'selected' : '' %>>April</option>
                    <option value="Mei" <%= bulan === 'Mei' ? 'selected' : '' %>>Mei</option>
                    <option value="Juni" <%= bulan === 'Juni' ? 'selected' : '' %>>Juni</option>
                    <option value="Juli" <%= bulan === 'Juli' ? 'selected' : '' %>>Juli</option>
                    <option value="Agustus" <%= bulan === 'Agustus' ? 'selected' : '' %>>Agustus</option>
                    <option value="September" <%= bulan === 'September' ? 'selected' : '' %>>September</option>
                    <option value="Oktober" <%= bulan === 'Oktober' ? 'selected' : '' %>>Oktober</option>
                    <option value="November" <%= bulan === 'November' ? 'selected' : '' %>>November</option>
                    <option value="Desember" <%= bulan === 'Desember' ? 'selected' : '' %>>Desember</option>
                </select>
                <input type="text" name="keyword" class="input-search" placeholder="Cari" value="<%= keyword %>">
            </form>

            <% if (bulan) { %>
                <div style="display: flex; gap: 5px;">
                    <button id="btnSetDone" style="background: #4eb554; color: white; border: none; padding: 0 15px; border-radius: 5px; font-weight: bold; cursor: pointer; height: 40px; display: flex; align-items: center; gap: 5px;" title="Tandai semua selesai">
                        ✅ Done
                    </button>

                    <button id="btnSetPending" style="background: #e39a5a; color: white; border: none; padding: 0 15px; border-radius: 5px; font-weight: bold; cursor: pointer; height: 40px; display: flex; align-items: center; gap: 5px;" title="Reset jadi pending">
                        ⏳ Pending
                    </button>
                </div>

                <script>
                    document.addEventListener("DOMContentLoaded", function() {
                        const btnDone = document.getElementById('btnSetDone');
                        const btnPending = document.getElementById('btnSetPending');
                        
                        async function updateAllStatus(targetStatus) {
                            const allCards = document.querySelectorAll('.list-card');
                            const deviceIds = Array.from(allCards).map(card => card.getAttribute('data-id'));

                            // AMBIL BULAN DARI DROPDOWN
                            const bulanSelect = document.querySelector('select[name="bulan"]');
                            const selectedBulan = bulanSelect ? bulanSelect.value : '';

                            if (deviceIds.length === 0) {
                                alert("Tidak ada data untuk diupdate.");
                                return;
                            }

                            const actionText = targetStatus === 'Done' ? "SELESAI (Done)" : "PENDING (Reset)";
                            if (!confirm(`Yakin ubah status ${deviceIds.length} perangkat menjadi ${actionText}?`)) {
                                return;
                            }

                            try {
                                const response = await fetch('/laptop/bulk-update', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ 
                                        ids: deviceIds, 
                                        status: targetStatus,
                                        bulan: selectedBulan // KIRIM BULAN KE BACKEND
                                    })
                                });

                                const result = await response.json();
                                if (result.success) {
                                    window.location.reload();
                                } else {
                                    alert("Gagal update data.");
                                }
                            } catch (e) {
                                console.error(e);
                                alert("Terjadi kesalahan sistem.");
                            }
                        }

                        btnDone.addEventListener('click', () => updateAllStatus('Done'));
                        btnPending.addEventListener('click', () => updateAllStatus('Pending'));
                    });
                </script>
            <% } %>
        </div>
    </div>

    <% 
       const listPending = laptops ? laptops.filter(item => item.status_terakhir !== 'Done') : [];
       const listDone = laptops ? laptops.filter(item => item.status_terakhir === 'Done') : [];
    %>

    <div class="split-container">
        
        <div class="col-split">
            <div class="col-header pending">
                <span>⏳ PENDING / PROSES</span>
                <span class="count-badge"><%= listPending.length %></span>
            </div>

            <% if (listPending.length === 0) { %>
                <div class="empty-msg">Tidak ada data pending.</div>
            <% } else { %>
                <% listPending.forEach(item => { %>
                    <div class="list-card" data-id="<%= item.device_id %>">
                        <div class="card-left">
                            <div class="model-text"><%= item.model %></div>
                            <div class="sn-text">SN: <%= item.serial_number %></div>
                            <div class="no-text">No: <%= item.no %></div>
                        </div>
                        <a href="/laptop/detail/<%= item.device_id %>" class="btn-detail">Detail</a>
                    </div>
                <% }) %>
            <% } %>
        </div>

        <div class="col-split">
            <div class="col-header done">
                <span>✅ SELESAI (DONE)</span>
                <span class="count-badge"><%= listDone.length %></span>
            </div>

            <% if (listDone.length === 0) { %>
                <div class="empty-msg">Belum ada yang selesai.</div>
            <% } else { %>
                <% listDone.forEach(item => { %>
                    <div class="list-card" data-id="<%= item.device_id %>">
                        <div class="card-left">
                            <div class="model-text"><%= item.model %></div>
                            <div class="sn-text">SN: <%= item.serial_number %></div>
                            <div class="no-text">No: <%= item.no %></div>
                        </div>
                        <a href="/laptop/detail/<%= item.device_id %>" class="btn-detail">Detail</a>
                    </div>
                <% }) %>
            <% } %>
        </div>

    </div>
</main>