<main class="main">
    <div class="page-header">
      <div class="page-title">Profil User</div>
  <div class="user-container">

    <!-- KIRI: AVATAR -->
    <div class="user-avatar">
      <img src="/images/Pinterest.jpg" alt="Avatar" class="avatar-preview">

      <form action="/user/avatar" method="POST" enctype="multipart/form-data">
        <label class="upload-btn">
          Ganti Foto
          <input type="file" name="avatar" hidden>
        </label>
      </form>
    </div>

    <!-- KANAN: FORM USER -->
    <div class="user-form">

      <form action="/user/update" method="POST">
        <div class="form-group">
          <label>Nama</label>
          <input type="text" name="nama" value="Admin Satu">
        </div>

        <div class="form-group">
          <label>Unit</label>
          <input type="text" name="unit" value="ICT Unit">
        </div>

        <div class="form-group">
          <label>Jabatan</label>
          <input type="text" name="jabatan" value="Administrator">
        </div>

        <div class="form-group">
          <label>Tanda Tangan</label>
          <input type="file" name="ttd">
          <small>Dipakai otomatis saat unduh laporan</small>
          
        </div>
        <div class="form-group">
          <button class="btn primary">Simpan</button>
        </div>
        
      </form>
    </div>

  </div>
    </div>
</main>
